{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/image/:match*",
      "destination": "https://rpnaqrmquddupmxvvcjg.supabase.co/storage/v1/object/public/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
